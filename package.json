{
  "name": "scripted-browser-video-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scripted browser tutorial video generator with Playwright, TTS, subtitles, and ffmpeg rendering",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/**/*.unit.test.ts",
    "test:video-poc": "tsx --test tests/video-generator/playwright-video-poc.test.ts",
    "test": "npm run typecheck && npm run test:unit",
    "build:manual": "tsc -p tsconfig.manual-recording.json && node scripts/copy-manual-recording-assets.mjs",
    "manual:recording": "npm run build:manual && node scripts/run-manual-recording.mjs",
    "build:manual-poc": "tsc -p tsconfig.electron-poc.json && node scripts/copy-manual-poc-assets.mjs",
    "poc:manual-capture": "npm run build:manual-poc && node scripts/run-manual-capture-poc.mjs",
    "test:manual-capture-poc": "node scripts/verify-manual-poc.mjs capture",
    "test:manual-clock-poc": "node scripts/verify-manual-poc.mjs clock",
    "test:manual-clock-long-poc": "node scripts/verify-manual-poc.mjs clock-long",
    "test:manual-events-poc": "node scripts/verify-manual-poc.mjs events",
    "test:editing-poc": "tsx --test tests/video-generator/editing-preview-poc.test.ts",
    "test:manual-integration": "tsx --test tests/video-generator/manual-*.integration.test.ts",
    "test:manual-e2e": "tsx --test tests/video-generator/manual-end-to-end.test.ts",
    "test:manual-product": "npm run test:manual-integration && npm run test:manual-e2e",
    "video:generate": "tsx src/cli/video-generator.ts",
    "video:guide": "tsx src/cli/manual-guide.ts",
    "video:record": "npm run build:manual && tsx src/cli/manual-record.ts",
    "video:pickup": "npm run build:manual && tsx src/cli/manual-pickup.ts",
    "video:analyze": "tsx src/cli/manual-analyze.ts",
    "video:preview": "tsx src/cli/manual-preview.ts",
    "video:review": "npm run build:manual && tsx src/cli/manual-review.ts",
    "video:narration": "tsx src/cli/manual-narration.ts",
    "video:finalize": "tsx src/cli/manual-finalize.ts",
    "verify:manual": "tsx scripts/verify-manual-product.mjs",
    "video:doctor": "tsx src/cli/video-doctor.ts",
    "video:tts-smoke": "tsx src/cli/video-generator.ts --tts-smoke"
  },
  "devDependencies": {
    "@types/node": "^22",
    "electron": "43.1.1",
    "playwright": "^1.58.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
